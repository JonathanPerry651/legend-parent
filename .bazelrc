
# Common Bazel flags
build --java_language_version=11
build --tool_java_language_version=11
build --java_runtime_version=11
build --javacopt="-source 11 -target 11"

# User requested flag
build --experimental_output_paths=strip

# Remote Execution (Buildbarn)
# build --remote_executor=grpc://localhost:8980
# build --remote_cache=grpc://localhost:8980
# build --remote_timeout=3600
# build --spawn_strategy=remote
# build --remote_instance_name=buildbarn
# build --strategy=Javac=remote
# build --strategy=Closure=remote
# build --strategy=Genrule=remote

# Remote JDK Configuration
# build --extra_toolchains=@rules_java//toolchains:remote_jdk11
# build --java_runtime_version=remotejdk_11
# build --tool_java_runtime_version=remotejdk_11
# build --java_runtime_version=remotejdk_11